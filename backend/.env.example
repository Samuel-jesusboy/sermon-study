# Copy this file to .env and fill in your values. Never commit .env.

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# The public anon / publishable key. The server acts as each signed-in user, so row-level security applies.
SUPABASE_KEY=your_supabase_anon_or_publishable_key

# --- AI: set at least one ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=          # also turns on semantic search (embeddings) and is a Whisper fallback
GROQ_API_KEY=            # cheap, fast; also used for Whisper audio transcription

# Which provider the app uses unless the user picks another (openai | claude | groq)
# DEFAULT_AI=openai

# Each job uses a model tier (defaults shown). main: sermon documents and study guides;
# premium: optional upgrade for important sermons; fast: Ask and verse explanations;
# tiny: finding where the sermon starts.
# OPENAI_MODEL_MAIN=gpt-5.4
# OPENAI_MODEL_PREMIUM=gpt-5.5
# OPENAI_MODEL_FAST=gpt-5.4-mini
# OPENAI_MODEL_TINY=gpt-5.4-nano
# CLAUDE_MODEL_MAIN=claude-sonnet-5-5
# CLAUDE_MODEL_PREMIUM=claude-opus-5-5
# CLAUDE_MODEL_FAST=claude-haiku-5-5
# CLAUDE_MODEL_TINY=claude-haiku-5-5
# GROQ_MODEL_MAIN=openai/gpt-oss-120b
# GROQ_MODEL_TINY=openai/gpt-oss-20b
# NOTES_MAX_TOKENS=16000
# EMBEDDINGS_ENABLED=true
# EMBEDDING_MODEL=text-embedding-3-small

# Cost tracking uses list prices in app/pricing.py. Override a model's price if it changes:
# PRICE_OVERRIDES={"gpt-5.4": [2.5, 0.25, 15]}

# --- YouTube access from a hosted server (YouTube blocks most cloud IPs) ---
# YT_PROXY_URL=http://user:pass@proxy-host:port
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# YTDLP_COOKIES_FILE=/etc/secrets/youtube-cookies.txt
# TRANSCRIPT_LANGUAGES=en,en-US,en-GB,en-NG
# WHISPER_PROVIDER=groq                    # groq (cheapest) | openai
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo # or whisper-large-v3 for more accuracy
# OPENAI_WHISPER_MODEL=gpt-transcribe       # whisper-1 is retired in Feb 2027

# --- Limits and hosting ---
# MONTHLY_SERMON_LIMIT=0          # 0 = unlimited
# PLAYLIST_MAX_VIDEOS=25
# MAX_UPLOAD_MB=200
# JOB_WORKERS=2
# CORS_ORIGINS=https://your-site.netlify.app
# APP_URL=https://your-site.netlify.app
