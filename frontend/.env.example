# Copy to frontend/.env for local development (and set the same values in Netlify).
REACT_APP_API_URL=http://localhost:8000
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
# The public anon / publishable key (safe in the browser; row-level security protects the data)
REACT_APP_SUPABASE_KEY=your_supabase_anon_or_publishable_key
